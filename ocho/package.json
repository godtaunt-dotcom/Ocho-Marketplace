{
  "name": "ocho",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k -n \"api,web\" -c \"blue,green\" \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w server && npm run build -w client",
    "test": "npm run test -w server",
    "db:migrate": "npm run prisma:migrate -w server",
    "db:generate": "npm run prisma:generate -w server",
    "db:seed": "npm run prisma:seed -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
