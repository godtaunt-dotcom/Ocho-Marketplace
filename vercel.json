{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "ocho/client/dist",
  "framework": "vite",
  "functions": {
    "api/index.ts": {
      "includeFiles": "{api/seed.db,ocho/server/prisma/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
